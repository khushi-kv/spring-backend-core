# Copy this file to .env and fill in the values (.env is git-ignored)

# Required: Base64-encoded JWT signing key (at least 256 bits), e.g. `openssl rand -base64 64`
JWT_SECRET=<your-base64-key>

# Dev profile seed users (an account is skipped if its password is empty)
SEED_ADMIN_PASSWORD=<choose-a-password>
SEED_STAFF_PASSWORD=<choose-a-password>
